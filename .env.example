DB_NAME=synapsis
DB_USER=synapsis
DB_PASSWORD=synapsis_password
DB_HOST=postgres
DB_PORT=5432
SECRET_KEY=change-me-local-dev-secret

# SMTP settings for real password reset emails.
# Fill these in .env and restart the backend container.
# Yandex: SMTP_HOST=smtp.yandex.ru, SMTP_PORT=587, SMTP_USE_TLS=true
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USE_TLS=true
# Mail.ru: SMTP_HOST=smtp.mail.ru, SMTP_PORT=465, SMTP_USE_SSL=true, SMTP_USE_TLS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=Synapsis
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10
